{"nodes": [{"id": "docker_compose_stack", "label": "Docker Compose Stack", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local stack of Postgres, Keycloak, the API, the Vite frontend, and Nginx. Each service restarts unless stopped, and dependents wait until healthchecks pass."}, {"id": "docker_compose_postgres", "label": "Postgres Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres:17-alpine. Readiness is pg_isready against POSTGRES_USER and POSTGRES_DB. Data is stored in ./data/postgres."}, {"id": "docker_compose_keycloak", "label": "Keycloak Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "quay.io/keycloak/keycloak:26.7.3 runs start-dev, persists in Postgres, and is published as host port 8082 to container port 8080. KC_HOSTNAME is http://localhost:8082."}, {"id": "docker_compose_backend", "label": "Backend Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from ./backend and published as host port 8001 to container port 8000. Health is HTTP GET /health. It waits for healthy Postgres and Keycloak."}, {"id": "docker_compose_frontend", "label": "Frontend Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node:22-alpine runs the Vite dev server from the bind-mounted ./frontend tree on port 5173. CHOKIDAR_USEPOLLING is enabled. node_modules is a named volume."}, {"id": "docker_compose_nginx", "label": "Nginx Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nginx:1.27-alpine publishes host port 5174 and loads ./nginx.conf. It starts only after backend and frontend are healthy."}, {"id": "docker_compose_postgres_settings", "label": "Postgres Connection Settings", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD configure the Postgres service. Keycloak's JDBC URL reuses all three. The API URL reuses the user and password and hardcodes the database name pm."}, {"id": "docker_compose_database_url", "label": "Backend DATABASE_URL", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/pm. The hostname is the Postgres service. The database name is the literal pm, not ${POSTGRES_DB}."}, {"id": "docker_compose_logic_silicon_realm", "label": "logic-silicon Realm", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both KEYCLOAK_ISSUER and KEYCLOAK_JWKS_URL address the realm path /realms/logic-silicon."}, {"id": "docker_compose_keycloak_issuer", "label": "KEYCLOAK_ISSUER", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "http://localhost:8082/realms/logic-silicon is the issuer browsers see on the published Keycloak port."}, {"id": "docker_compose_keycloak_jwks_url", "label": "KEYCLOAK_JWKS_URL", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Certs are fetched in-network at http://keycloak:8080/realms/logic-silicon/protocol/openid-connect/certs, while the issuer URL uses the host-published address localhost:8082."}, {"id": "docker_compose_keycloak_audience", "label": "KEYCLOAK_AUDIENCE", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected token audience is backend-api."}, {"id": "docker_compose_keycloak_authorized_party", "label": "KEYCLOAK_AUTHORIZED_PARTY", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected authorized party is react-app."}, {"id": "docker_compose_backend_api", "label": "backend-api Client", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_react_app", "label": "react-app Client", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_cors_origins", "label": "CORS Origins", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows the published app origins on port 5174 and the Vite origins on port 5173, for both localhost and 127.0.0.1."}, {"id": "docker_compose_kc_bootstrap_admin", "label": "Keycloak Bootstrap Admin", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KC_BOOTSTRAP_ADMIN_USERNAME and KC_BOOTSTRAP_ADMIN_PASSWORD create the initial Keycloak admin."}, {"id": "docker_compose_frontend_node_modules", "label": "frontend_node_modules Volume", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named volume mounted at /app/node_modules so dependencies stay off the host bind mount of ./frontend."}, {"id": "docker_compose_postgres_data", "label": "Postgres Data Volume", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host path ./data/postgres is mounted at /var/lib/postgresql/data."}, {"id": "docker_compose_nginx_conf", "label": "nginx.conf", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mounted read-only as /etc/nginx/conf.d/default.conf."}], "edges": [{"source": "backend_requirements_psycopg", "target": "docker_compose_database_url", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "docker_compose_keycloak", "target": "docker_compose_postgres", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "docker_compose_keycloak", "target": "docker_compose_postgres", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "docker_compose_backend", "target": "docker_compose_postgres", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confi